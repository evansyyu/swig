# Copy to .env in this folder. Never commit your real API key.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# macOS: port 5000 is taken by AirPlay Receiver, so use 5001 there.
PORT=5001

# Optional: this computer's local Wi-Fi IPv4 address if auto-detection is wrong.
# Only used to print the address to put in the firmware's secrets.h.
# SERVER_IP=192.168.1.42
