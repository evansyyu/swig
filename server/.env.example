# Copy to .env in this folder. Never commit real secrets.
# macOS: port 5000 is taken by AirPlay Receiver, so use 5001 there.
PORT=5001

# Optional: this computer's local Wi-Fi IPv4 address if auto-detection is wrong.
# Only used to print the address to use as EXPO_PUBLIC_API_URL for a local server.
# SERVER_IP=192.168.1.42

# Accounts (v2). Railway: add the Postgres plugin and set DATABASE_URL=${{Postgres.DATABASE_URL}}.
# Without it, a SQLite file in server/data/ is used (wiped on every Railway deploy).
# DATABASE_URL=
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
DEFAULT_TIMEZONE=America/New_York
