# Copy to .env in this folder. Never commit your real API key.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Exact device name shown in Google Home.
NEST_NAME=Nest Mini
PORT=5000

# Optional: this computer's local Wi-Fi IPv4 address if auto-detection is wrong.
# Do not use localhost. The speaker must be able to reach this address.
# SERVER_IP=192.168.1.42
